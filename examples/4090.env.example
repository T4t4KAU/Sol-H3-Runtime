# Copy outside the source package and replace paths for your GPU server.
export SOL_H3_PYTHON=/Datasets/public_models/SOL-H3/envs/solh3-4090/bin/python
export SOL_H3_ASSETS=/Datasets/public_models/SOL-H3
export SOL_H3_MODEL="$SOL_H3_ASSETS/MiniMax-H3"
export SOL_H3_ADAPTER="$SOL_H3_ASSETS/FastH3-4-step-Preview-v1-LoRA/dense-datafree/adapter_model.safetensors"
export SOL_H3_OUTPUTS=/path/to/outputs
# Device indices must refer to GPUs allocated to this process/container.
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
