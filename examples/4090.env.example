# Copy outside the source package and replace paths for your GPU server.
export SOL_H3_PYTHON=/path/to/sol-h3-4090-env/bin/python
export SOL_H3_ASSETS=/path/to/checkpoints
export SOL_H3_OUTPUTS=/path/to/outputs
# Device indices must refer to GPUs allocated to this process/container.
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
